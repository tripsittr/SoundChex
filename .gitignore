*.vtt

# PDFs are media here (the book library), but documentation may need one.
*.pdf
!docs/**/*.pdf

# Databases and their journals — a SQLite file holds the whole catalog.
*.sqlite
*.sqlite-*
*.db
.env.e2e

# Playwright output
/test-results
/playwright-report

# Tauri build output
/src-tauri/target
/src-tauri/gen
/src-tauri/runtime/
