{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "build": "node scripts/stamp-release.mjs && vite build && node scripts/embed-offline-shell.mjs && node scripts/build-tauri-bridge.mjs",
        "dev": "vite",
        "release": "node scripts/release.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "bash tests/e2e/bootstrap.sh && playwright test",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "check:target": "node scripts/check-stale-target.mjs",
        "tauri:build": "npm run check:target && cross-env CI=true tauri build",
        "build:server": "npm run check:target && npm run build && cross-env CI=true tauri build --config src-tauri/tauri.server.conf.json",
        "dev:server": "npm run check:target && tauri dev --config src-tauri/tauri.server.conf.json",
        "reinstall:server": "bash scripts/reinstall-server-app.sh"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "alpinejs": "^3.15.12",
        "cross-env": "^10.1.0",
        "epubjs": "^0.3.93",
        "jsdom": "^30.0.1",
        "jszip": "^3.10.1",
        "laravel-vite-plugin": "^3.1",
        "pdfjs-dist": "^4.10.38",
        "tailwindcss": "^4.3.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-opener": "^2.5.5",
        "@tauri-apps/plugin-updater": "^2.10.1"
    }
}
