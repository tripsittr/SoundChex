{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal surface. The shell adds no privileged commands of its own: everything the user sees is the web app. Notifications and biometric prompts are the two exceptions, because neither has a web equivalent inside a Tauri webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://localhost:*/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://192.168.1.205:*",
      "http://192.168.1.205:*/*",
      "http://100.106.62.120:*",
      "http://100.106.62.120:*/*",
      "https://*.ts.net",
      "https://*.ts.net/*",
      "https://*.ts.net:*",
      "https://*.ts.net:*/*"
    ]
  }
}
