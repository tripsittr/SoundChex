{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Biometric unlock. iOS and Android only \u2014 there is no desktop implementation, so this capability is scoped to those platforms rather than sitting in the default set and failing to resolve on a desktop build.",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "biometric:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://localhost:*/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://192.168.1.205:*",
      "http://192.168.1.205:*/*",
      "http://100.106.62.120:*",
      "http://100.106.62.120:*/*",
      "https://*.ts.net",
      "https://*.ts.net/*",
      "https://*.ts.net:*",
      "https://*.ts.net:*/*"
    ]
  }
}
