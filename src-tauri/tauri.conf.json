{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundChex",
  "version": "0.1.0",
  "identifier": "net.soundchex.client",
  "build": {
    "frontendDist": "../public/tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundChex",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "url": "index.html",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' https: http: ; img-src 'self' https: http: data: blob: asset: http://asset.localhost ; media-src 'self' https: http: blob: asset: http://asset.localhost ; style-src 'self' 'unsafe-inline' https: http: ; script-src 'self' 'unsafe-inline' https: http: ; connect-src 'self' https: http: asset: http://asset.localhost ",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      },
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Your media library",
    "longDescription": "A client for a self-hosted SoundChex library.",
    "iOS": {
      "developmentTeam": "7GSWB72PH6"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://macbookair.tail7e590c.ts.net/api/v1/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyODJBNzYyMzRCMEQxMDcKUldRSDBiQTBZcWVDWXRQUjhXeWFpTEFFbVZtZCtNOXk2SzNxVk5xLzBXc1JrRDV1RHFacVhWdTMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
