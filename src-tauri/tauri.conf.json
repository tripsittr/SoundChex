{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundChex",
  "version": "0.1.0",
  "identifier": "net.soundchex.client",
  "build": {
    "frontendDist": "../public/tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundChex",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "url": "index.html",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' https: ; img-src 'self' https: data: blob: ; media-src 'self' https: blob: ; style-src 'self' 'unsafe-inline' https: ; script-src 'self' 'unsafe-inline' https: ; connect-src 'self' https: ",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Your media library",
    "longDescription": "A client for a self-hosted SoundChex library.",
    "iOS": {
      "developmentTeam": "7GSWB72PH6"
    }
  }
}
