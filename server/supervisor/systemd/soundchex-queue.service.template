# SoundChex bundled server — queue worker (systemd, Linux). S-151 Step 4.
[Unit]
Description=SoundChex queue worker
After=network.target

[Service]
Type=simple
ExecStart={{RUNTIME_DIR}}/bin/php {{APP_DIR}}/artisan queue:work --tries=1 --timeout=21900
WorkingDirectory={{APP_DIR}}
Restart=always
RestartSec=2
{{USER_LINE}}

[Install]
WantedBy=multi-user.target
