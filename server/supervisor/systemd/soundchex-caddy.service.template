# SoundChex bundled server — Caddy (systemd, Linux). S-151 Step 4.
[Unit]
Description=SoundChex Caddy (web server / reverse proxy)
After=network.target soundchex-fpm.service
Wants=soundchex-fpm.service

[Service]
Type=simple
ExecStart={{RUNTIME_DIR}}/bin/caddy run --config {{CONFIG_DIR}}/Caddyfile --adapter caddyfile
WorkingDirectory={{APP_DIR}}
Environment=SOUNDCHEX_ROOT={{APP_PUBLIC}}
Environment=SOUNDCHEX_FPM=127.0.0.1:9100
Environment=SOUNDCHEX_LISTEN={{LISTEN}}
Environment=SOUNDCHEX_LOG={{LOG_DIR}}/caddy-access.log
Environment=XDG_DATA_HOME={{DATA_DIR}}
Environment=XDG_CONFIG_HOME={{CONFIG_DIR}}
# Binding a low port (<1024) needs this; harmless on a high port.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
{{USER_LINE}}

[Install]
WantedBy=multi-user.target
