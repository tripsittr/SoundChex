<?xml version="1.0" encoding="UTF-8"?>
<!--
  SoundChex bundled server — queue worker (launchd, macOS). S-151 Step 4.
  Runs artisan queue:work with the BUNDLED php, not Herd's. Placeholders
  substituted at install time.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.soundchex.queue</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{RUNTIME_DIR}}/bin/php</string>
		<string>{{APP_DIR}}/artisan</string>
		<!--
		  `queue:workers`, not `queue:work`: it runs as many workers as the
		  panel's concurrency setting asks for and re-reads it on a timer, so
		  changing the number does not mean editing this file and reinstalling.
		-->
		<string>queue:workers</string>
		<!--
		  Every queue the pipeline uses, in priority order (#465).

		  A bare `queue:work` serves `default` only, so the io, cpu and net
		  stages sit unprocessed forever: the worker looks healthy, the
		  dashboard says "nothing is being worked on", and the jobs pile up.
		  Observed on a live install with 36 jobs stranded on `net` for three
		  hours while a worker ran.

		  Ordered so cheap work is never stuck behind expensive: `default`
		  holds the transitions, `net` waits on other people's servers, `cpu`
		  reads files, and `io` hashes and moves bytes, which is slowest. The
		  Rust supervisor in src-tauri/src/supervisor.rs passes the same list;
		  the two must not drift.
		-->
		<string>--queue=default,net,cpu,io</string>
		<string>--timeout=21900</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{LOG_DIR}}/queue.log</string>
	<key>StandardOutPath</key>
	<string>{{LOG_DIR}}/queue.log</string>
	<key>WorkingDirectory</key>
	<string>{{APP_DIR}}</string>
</dict>
</plist>
