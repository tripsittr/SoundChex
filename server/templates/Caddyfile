# SoundChex bundled server — Caddyfile (S-151).
#
# Caddy owns the port and serves public/ static files directly; everything else
# is reverse-proxied to php-fpm. The upload cap is OURS here (25 MB), unlike the
# 2 MB `artisan serve` default that broke playlist-cover uploads.
#
# Placeholders substituted by the supervisor / installer at launch:
#   {$SOUNDCHEX_ROOT}    absolute path to the app's public/ directory
#   {$SOUNDCHEX_FPM}     php-fpm address (default 127.0.0.1:9100)
#   {$SOUNDCHEX_LISTEN}  the bind address (e.g. :8000, or :443 with TLS in Step 7)
#   {$SOUNDCHEX_LOG}     access-log file path
#
# TLS (S-151 Step 7). Three modes, chosen by how you reach the server:
#
#  1. Behind a TLS proxy (DEFAULT here) — tailscale serve / SCNet / a reverse
#     proxy terminates HTTPS and forwards to this plaintext listener. The
#     trusted_proxies option below makes Caddy honor the proxy's
#     X-Forwarded-Proto/Host, which Laravel's trustProxies reads to generate
#     https:// URLs. private_ranges covers LAN reverse proxies; 100.64.0.0/10 is
#     Tailscale's CGNAT range.
#  2. Direct with a real domain — remove `auto_https off`, change the site label
#     from {$SOUNDCHEX_LISTEN} to your domain (e.g. media.example.com), and Caddy
#     provisions a Let's Encrypt cert automatically. Drop trusted_proxies then.
#  3. Direct on a LAN with no domain — use `tls internal` on the site to serve
#     Caddy's local CA cert (which each client must trust once).

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

{$SOUNDCHEX_LISTEN} {
	# Quoted: an install path may contain spaces (e.g. "SoundChex App"), which
	# Caddy would otherwise read as extra arguments.
	root * "{$SOUNDCHEX_ROOT}"
	encode gzip

	# The cap is ours now. Caddy rejects an over-cap body with 413 before PHP
	# ever sees it (a hard gate — not just post_max_size).
	request_body {
		max_size 25MB
	}

	php_fastcgi {$SOUNDCHEX_FPM}
	file_server

	log {
		output file "{$SOUNDCHEX_LOG}"
	}
}
