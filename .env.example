APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DEV_LOGIN_AUTOFILL=false
DEV_LOGIN_EMAIL=test@test.com
DEV_LOGIN_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Folders to scan for media. Absolute paths, comma-separated. Everything found
# is catalogued, identified and filed; nothing is moved out of these folders
# until it is.
#
#   macOS/Linux   LIBRARY_WATCH_FOLDERS=/Users/you/Music,/Volumes/Media/Films
#   Windows       LIBRARY_WATCH_FOLDERS=D:\Media\Music,D:\Media\Films
LIBRARY_WATCH_FOLDERS=

# ---------------------------------------------------------------------------
# Radarr, Sonarr and Lidarr (optional)
# ---------------------------------------------------------------------------
# Only needed if you run the acquisition stack in docker/arr/compose.yaml.
# SoundChex works without it; the admin page simply reports it as not running.
#
# These apps find and fetch new media. SoundChex catalogs what already exists.
# They meet at the folder the scanner watches: a finished download lands there
# and becomes a catalogued item within a scan interval, with nothing having to
# tell SoundChex it happened.
#
# Nothing is downloaded until you add an indexer inside each app by hand. None
# ship with the images and none are configured here.

# Where each app keeps its own database and settings. Outside the repo on
# purpose: this is state, it grows, and it holds the API keys below.
ARR_CONFIG_ROOT=/Users/you/Library/Application Support/SoundChex/arr

# Where the download client writes. Also outside the repo, and on a disk with
# room — this is the one that fills up.
ARR_DOWNLOADS_ROOT=/Users/you/Downloads/soundchex

# The inbox the scanner watches, mounted into the containers as /media so a
# completed file can be moved straight into it. Usually
# storage/app/private/media inside this project.
SOUNDCHEX_MEDIA_ROOT=/path/to/SoundChex/storage/app/private/media

# The user files should be owned by — yours, not root. `id -u` and `id -g`.
ARR_PUID=501
ARR_PGID=20
ARR_TZ=America/Chicago

# Read from each app's Settings → General once it is running. Stored encrypted
# in the settings table when entered through the admin page, which is the
# preferred route; these are only read as a fallback for a headless setup.
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
